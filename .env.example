# ─────────────────────────────────────────────────────────────
# SAMSMARANA — Environment Variables (example)
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` — it is gitignored.
# ─────────────────────────────────────────────────────────────

# SQLite database file location (Prisma)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Google Gemini / Veo (server-side ONLY) ──────────────────
# Used exclusively by the server-only video-generation API route.
# Never referenced from client code, never exposed to the browser.
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the Veo model used for generation.
# Defaults to "veo-3.0-generate-001".
# Alternatives: "veo-2.0-generate-001", "veo-3.0-fast-generate-001"
VEO_MODEL=veo-3.0-generate-001

# Optional: video generation timeout (ms) for the long-running operation polling.
VEO_POLL_TIMEOUT_MS=180000

# Session signing secret for the lightweight demo session (httpOnly cookie).
SESSION_SECRET=samsmarana-dev-secret-change-me

# ── Supabase (production backend) ───────────────────────────
# The local demo uses Prisma/SQLite (DATABASE_URL above) and runs without
# these. To point the app at Supabase instead, fill these in and follow
# supabase/SETUP.md.
# Browser-safe (public):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — NEVER in client code or Git:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
